#!/usr/bin/env bash
# Minimal MPRIS client over D-Bus (stands in for playerctl).
# usage: mpris now                       print "title - artist" of the playing player
#        mpris play-pause|next|previous  control the player

path=/org/mpris/MediaPlayer2
iface=org.mpris.MediaPlayer2.Player

players() {
    busctl --user list --no-legend 2>/dev/null | awk '$1 ~ /^org\.mpris\.MediaPlayer2\./ { print $1 }'
}

status() {
    busctl --user get-property "$1" $path $iface PlaybackStatus 2>/dev/null | sed 's/^s "\(.*\)"$/\1/'
}

# The playing player if there is one, else the first one found.
pick() {
    local p first=
    for p in $(players); do
        [ "$(status "$p")" = Playing ] && { echo "$p"; return; }
        : "${first:=$p}"
    done
    [ -n "$first" ] && echo "$first"
}

# Print the first string of a Metadata field from busctl's text output,
# e.g. "xesam:title" s "Song", undoing busctl's \xNN and \" escapes.
field() {
    printf '%b' "$(printf '%s' "$meta" |
        sed -n 's/.*"'"$1"'" '"$2"' "\(\([^"\\]\|\\.\)*\)".*/\1/p')" | sed 's/\\"/"/g'
}

case $1 in
now)
    for p in $(players); do
        [ "$(status "$p")" = Playing ] || continue
        meta=$(busctl --user get-property "$p" $path $iface Metadata 2>/dev/null)
        title=$(field xesam:title s)
        artist=$(field xesam:artist 'as [0-9]*')
        printf '%s\n' "$title${title:+${artist:+ - }}$artist" |
            LC_ALL=C.UTF-8 sed 'y/！＂＃＄％＆＇（）＊＋，－．／０１２３４５６７８９：；＜＝＞？＠ＡＢＣＤＥＦＧＨＩＪＫＬＭＮＯＰＱＲＳＴＵＶＷＸＹＺ［＼］＾＿｀ａｂｃｄｅｆｇｈｉｊｋｌｍｎｏｐｑｒｓｔｕｖｗｘｙｚ｛｜｝～　/!"#$%&'\''()*+,-.\/0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~ /'
        exit
    done
    exit ;;
play-pause) method=PlayPause ;;
next) method=Next ;;
previous) method=Previous ;;
*) echo "usage: mpris now|play-pause|next|previous" >&2; exit 1 ;;
esac

p=$(pick) && [ -n "$p" ] && busctl --user call "$p" $path $iface "$method"
